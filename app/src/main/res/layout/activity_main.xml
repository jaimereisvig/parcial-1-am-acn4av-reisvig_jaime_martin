<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mc_bg">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/space_xl">

        <TextView
            android:id="@+id/tv_marca"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/mc_ink"
            android:textSize="@dimen/text_brand"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/iv_hero"
            android:layout_width="@dimen/hero_size"
            android:layout_height="@dimen/hero_size"
            android:layout_marginTop="@dimen/space_xxl"
            android:src="@drawable/hero_changuito"
            android:scaleType="fitCenter"
            android:contentDescription="@string/home_hero_desc"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_marca" />

        <TextView
            android:id="@+id/tv_titulo_hero"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:text="@string/home_hero_titulo"
            android:textColor="@color/mc_ink"
            android:textSize="@dimen/text_hero"
            android:textStyle="bold"
            android:gravity="center"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/iv_hero" />

        <TextView
            android:id="@+id/tv_subtitulo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:text="@string/home_hero_subtitulo"
            android:textColor="@color/mc_muted"
            android:textSize="@dimen/text_body"
            android:gravity="center"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_titulo_hero" />

        <Button
            android:id="@+id/btn_armar_menu"
            android:layout_width="0dp"
            android:layout_height="@dimen/touch_height"
            android:layout_marginTop="@dimen/space_xl"
            android:text="@string/home_armar_menu"
            android:textColor="@color/mc_accent_ink"
            android:backgroundTint="@color/mc_accent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_subtitulo" />

        <TextView
            android:id="@+id/tv_como_funciona"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:padding="@dimen/space_sm"
            android:text="@string/home_como_funciona"
            android:textColor="@color/mc_accent"
            android:textSize="@dimen/text_action"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btn_armar_menu" />

        <View
            android:id="@+id/divider"
            android:layout_width="0dp"
            android:layout_height="@dimen/divider_height"
            android:layout_marginTop="@dimen/space_xl"
            android:background="@color/mc_line"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_como_funciona" />

        <Button
            android:id="@+id/btn_ir_ingredientes"
            android:layout_width="0dp"
            android:layout_height="@dimen/touch_height"
            android:layout_marginTop="@dimen/space_lg"
            android:text="@string/screen_ingredientes"
            android:textColor="@color/mc_ink"
            android:backgroundTint="@color/mc_surface"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/divider" />

        <Button
            android:id="@+id/btn_ir_comidas"
            android:layout_width="0dp"
            android:layout_height="@dimen/touch_height"
            android:layout_marginTop="@dimen/space_sm"
            android:text="@string/screen_comidas"
            android:textColor="@color/mc_ink"
            android:backgroundTint="@color/mc_surface"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btn_ir_ingredientes" />

        <Button
            android:id="@+id/btn_ir_menus"
            android:layout_width="0dp"
            android:layout_height="@dimen/touch_height"
            android:layout_marginTop="@dimen/space_sm"
            android:text="@string/nav_menus"
            android:textColor="@color/mc_ink"
            android:backgroundTint="@color/mc_surface"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btn_ir_comidas" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>