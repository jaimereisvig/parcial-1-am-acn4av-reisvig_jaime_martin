<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mc_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_lg">

        <ImageView
            android:id="@+id/iv_imagen_detalle"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:scaleType="centerCrop"
            android:background="@drawable/bg_chip_neutral"
            android:contentDescription="@string/cd_imagen_sugerida" />

        <TextView
            android:id="@+id/tv_nombre_detalle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:textColor="@color/mc_ink"
            android:textSize="@dimen/text_title_screen"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_meta_detalle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:textColor="@color/mc_muted"
            android:textSize="@dimen/text_body" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:text="@string/detalle_sugerida_ingredientes"
            android:textColor="@color/mc_ink"
            android:textSize="@dimen/text_title_item"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/ll_ingredientes_detalle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="@dimen/space_sm" />

        <TextView
            android:id="@+id/tv_preparacion_detalle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:textColor="@color/mc_ink"
            android:textSize="@dimen/text_body" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:text="@string/detalle_sugerida_leyenda"
            android:textColor="@color/mc_muted"
            android:textSize="@dimen/text_chip" />

        <Button
            android:id="@+id/btn_importar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/touch_height"
            android:layout_marginTop="@dimen/space_md"
            android:text="@string/detalle_sugerida_importar"
            android:textColor="@color/mc_accent_ink"
            android:backgroundTint="@color/mc_accent" />

    </LinearLayout>
</ScrollView>