<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mc_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_lg">

        <TextView
            android:id="@+id/tv_titulo_comida"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/mc_ink"
            android:textSize="@dimen/text_title_screen"
            android:textStyle="bold"
            android:layout_marginBottom="@dimen/space_lg"
            android:text="@string/comida_nueva" />

        <TextView style="@style/McLabel" android:text="@string/label_nombre" />
        <EditText
            android:id="@+id/et_nombre_comida"
            style="@style/McInput"
            android:inputType="textCapSentences"
            android:hint="@string/hint_nombre_comida" />

        <TextView style="@style/McLabel" android:text="@string/label_comensales" />
        <EditText
            android:id="@+id/et_comensales"
            style="@style/McInput"
            android:inputType="number"
            android:hint="@string/hint_comensales" />

        <TextView style="@style/McLabel" android:text="@string/label_tipo" />
        <Spinner
            android:id="@+id/sp_tipo_comida"
            android:layout_width="match_parent"
            android:layout_height="@dimen/touch_height"
            android:layout_marginTop="@dimen/space_xs" />

        <TextView style="@style/McLabel" android:text="@string/label_categoria" />
        <Spinner
            android:id="@+id/sp_categoria_comida"
            android:layout_width="match_parent"
            android:layout_height="@dimen/touch_height"
            android:layout_marginTop="@dimen/space_xs" />

        <TextView style="@style/McLabel" android:text="@string/label_preparacion" />
        <EditText
            android:id="@+id/et_preparacion"
            style="@style/McInput"
            android:inputType="textMultiLine|textCapSentences"
            android:minLines="3"
            android:gravity="top"
            android:hint="@string/hint_preparacion" />

        <TextView style="@style/McLabel" android:text="@string/label_ingredientes" />

        <LinearLayout
            android:id="@+id/ll_ingredientes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="@dimen/space_xs" />

        <Button
            android:id="@+id/btn_agregar_ingrediente"
            android:layout_width="match_parent"
            android:layout_height="@dimen/touch_height"
            android:layout_marginTop="@dimen/space_sm"
            android:text="@string/comida_agregar_ingrediente"
            android:textColor="@color/mc_accent"
            android:backgroundTint="@color/mc_surface" />

        <Button
            android:id="@+id/btn_crear_ingrediente"
            android:layout_width="match_parent"
            android:layout_height="@dimen/touch_height"
            android:layout_marginTop="@dimen/space_sm"
            android:text="@string/comida_crear_ingrediente"
            android:textColor="@color/mc_accent"
            android:backgroundTint="@color/mc_surface" />

        <Button
            android:id="@+id/btn_borrar_comida"
            android:layout_width="match_parent"
            android:layout_height="@dimen/touch_height"
            android:layout_marginTop="@dimen/space_lg"
            android:text="@string/comida_eliminar"
            android:textColor="@color/mc_accent_ink"
            android:backgroundTint="@color/mc_danger"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="@dimen/space_xl">

            <Button
                android:id="@+id/btn_cancelar_comida"
                android:layout_width="0dp"
                android:layout_height="@dimen/touch_height"
                android:layout_weight="1"
                android:text="@string/action_cancel"
                android:textColor="@color/mc_ink"
                android:backgroundTint="@color/mc_band" />

            <Button
                android:id="@+id/btn_guardar_comida"
                android:layout_width="0dp"
                android:layout_height="@dimen/touch_height"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/space_md"
                android:text="@string/action_save"
                android:textColor="@color/mc_accent_ink"
                android:backgroundTint="@color/mc_accent" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>