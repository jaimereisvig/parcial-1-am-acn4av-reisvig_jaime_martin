<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mc_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="@dimen/space_lg">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/screen_lista_compras"
            android:textColor="@color/mc_ink"
            android:textSize="@dimen/text_title_screen"
            android:textStyle="bold"
            android:layout_marginBottom="@dimen/space_md" />

        <LinearLayout
            android:id="@+id/ll_barra_compra"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="@dimen/space_sm"
            android:visibility="gone">

            <TextView
                android:id="@+id/tv_progreso"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/mc_muted"
                android:textSize="@dimen/text_body" />

            <Button
                android:id="@+id/btn_donde_comprar"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:text="@string/compras_donde_comprar"
                android:textColor="@color/mc_accent"
                android:textSize="@dimen/text_action"
                android:layout_marginEnd="@dimen/space_sm" />

            <Button
                android:id="@+id/btn_reiniciar"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:text="@string/compras_reiniciar"
                android:textColor="@color/mc_accent"
                android:textSize="@dimen/text_action" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_donde_comprar_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/mc_muted"
            android:textSize="@dimen/text_body"
            android:layout_marginBottom="@dimen/space_sm"
            android:visibility="gone" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <LinearLayout
                    android:id="@+id/ll_lista"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>

            <TextView
                android:id="@+id/tv_lista_vacia"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="@string/compras_vacia"
                android:textColor="@color/mc_muted"
                android:textSize="@dimen/text_body"
                android:visibility="gone" />

        </FrameLayout>

    </LinearLayout>

</FrameLayout>