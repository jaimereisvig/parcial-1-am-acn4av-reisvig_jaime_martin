<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingVertical="@dimen/space_sm">

    <TextView
        android:id="@+id/tv_linea_ingrediente"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textColor="@color/mc_ink"
        android:textSize="@dimen/text_body" />

    <TextView
        android:id="@+id/btn_quitar_linea"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="@dimen/space_sm"
        android:text="Quitar"
        android:textColor="@color/mc_danger"
        android:textSize="@dimen/text_action" />

</LinearLayout>