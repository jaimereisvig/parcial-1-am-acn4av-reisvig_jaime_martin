<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mc_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tv_titulo_form"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/mc_ink"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp"
            android:text="Nuevo ingrediente" />

        <!-- Nombre -->
        <TextView style="@style/McLabel" android:text="Nombre" />
        <EditText
            android:id="@+id/et_nombre"
            style="@style/McInput"
            android:inputType="textCapSentences"
            android:hint="Ej. Tomate perita" />

        <!-- Góndola -->
        <TextView style="@style/McLabel" android:text="Categoría / góndola" />
        <Spinner
            android:id="@+id/sp_gondola"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp" />

        <!-- Tipo de medida -->
        <TextView style="@style/McLabel" android:text="Tipo de medida" />
        <Spinner
            android:id="@+id/sp_tipo_medida"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp" />

        <!-- Presentación: cantidad -->
        <TextView style="@style/McLabel" android:text="Presentación (cantidad)" />
        <EditText
            android:id="@+id/et_presentacion_cantidad"
            style="@style/McInput"
            android:inputType="numberDecimal"
            android:hint="Ej. 1000" />

        <!-- Nombre presentación -->
        <TextView style="@style/McLabel" android:text="Nombre de la presentación (opcional)" />
        <EditText
            android:id="@+id/et_nombre_presentacion"
            style="@style/McInput"
            android:inputType="text"
            android:hint="Ej. paquete" />

        <!-- Nombre unidad -->
        <TextView style="@style/McLabel" android:text="Nombre de la unidad (opcional)" />
        <EditText
            android:id="@+id/et_nombre_unidad"
            style="@style/McInput"
            android:inputType="text"
            android:hint="Ej. g" />

        <!-- En uso (solo en editar) -->
        <TextView
            android:id="@+id/tv_en_uso_form"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="@color/mc_muted"
            android:textSize="14sp"
            android:visibility="gone" />

        <!-- Borrar (solo en editar) -->
        <Button
            android:id="@+id/btn_borrar"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:text="Eliminar ingrediente"
            android:textColor="@color/mc_accent_ink"
            android:backgroundTint="@color/mc_danger"
            android:visibility="gone" />

        <!-- Cancelar / Guardar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="24dp">

            <Button
                android:id="@+id/btn_cancelar"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Cancelar"
                android:textColor="@color/mc_ink"
                android:backgroundTint="@color/mc_band" />

            <Button
                android:id="@+id/btn_guardar"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:text="Guardar"
                android:textColor="@color/mc_accent_ink"
                android:backgroundTint="@color/mc_accent" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>