<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mc_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_lg">

        <TextView
            android:id="@+id/tv_titulo_form"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/mc_ink"
            android:textSize="@dimen/text_title_screen"
            android:textStyle="bold"
            android:layout_marginBottom="@dimen/space_lg"
            android:text="Nuevo ingrediente" />

        <TextView style="@style/McLabel" android:text="Nombre" />
        <EditText
            android:id="@+id/et_nombre"
            style="@style/McInput"
            android:inputType="textCapSentences"
            android:hint="Ej. Tomate perita" />

        <TextView style="@style/McLabel" android:text="Categoría / góndola" />
        <Spinner
            android:id="@+id/sp_gondola"
            android:layout_width="match_parent"
            android:layout_height="@dimen/touch_height"
            android:layout_marginTop="@dimen/space_xs" />

        <TextView style="@style/McLabel" android:text="Tipo de medida" />
        <Spinner
            android:id="@+id/sp_tipo_medida"
            android:layout_width="match_parent"
            android:layout_height="@dimen/touch_height"
            android:layout_marginTop="@dimen/space_xs" />

        <TextView style="@style/McLabel" android:text="Presentación (cantidad)" />
        <EditText
            android:id="@+id/et_presentacion_cantidad"
            style="@style/McInput"
            android:inputType="numberDecimal"
            android:hint="Ej. 1000" />

        <TextView style="@style/McLabel" android:text="Nombre de la presentación (opcional)" />
        <EditText
            android:id="@+id/et_nombre_presentacion"
            style="@style/McInput"
            android:inputType="text"
            android:hint="Ej. paquete" />

        <TextView style="@style/McLabel" android:text="Nombre de la unidad (opcional)" />
        <EditText
            android:id="@+id/et_nombre_unidad"
            style="@style/McInput"
            android:inputType="text"
            android:hint="Ej. g" />

        <TextView
            android:id="@+id/tv_en_uso_form"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:textColor="@color/mc_muted"
            android:textSize="@dimen/text_action"
            android:visibility="gone" />

        <Button
            android:id="@+id/btn_borrar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/touch_height"
            android:layout_marginTop="@dimen/space_md"
            android:text="Eliminar ingrediente"
            android:textColor="@color/mc_accent_ink"
            android:backgroundTint="@color/mc_danger"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="@dimen/space_xl">

            <Button
                android:id="@+id/btn_cancelar"
                android:layout_width="0dp"
                android:layout_height="@dimen/touch_height"
                android:layout_weight="1"
                android:text="Cancelar"
                android:textColor="@color/mc_ink"
                android:backgroundTint="@color/mc_band" />

            <Button
                android:id="@+id/btn_guardar"
                android:layout_width="0dp"
                android:layout_height="@dimen/touch_height"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/space_md"
                android:text="Guardar"
                android:textColor="@color/mc_accent_ink"
                android:backgroundTint="@color/mc_accent" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>