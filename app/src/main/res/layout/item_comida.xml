<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_card"
    android:padding="@dimen/space_lg"
    android:layout_marginBottom="@dimen/space_md">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_nombre_comida"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/mc_ink"
            android:textSize="@dimen/text_title_item"
            android:textStyle="bold"
            tools:text="Milanesas con puré" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="@dimen/space_sm">

            <TextView
                android:id="@+id/tv_categoria_comida"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip_neutral"
                android:paddingHorizontal="@dimen/chip_padding_h"
                android:paddingVertical="@dimen/space_xs"
                android:textColor="@color/mc_muted"
                android:textSize="@dimen/text_chip"
                tools:text="Carnes Rojas" />

            <TextView
                android:id="@+id/tv_rinde"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_sm"
                android:background="@drawable/bg_chip_accent"
                android:paddingHorizontal="@dimen/chip_padding_h"
                android:paddingVertical="@dimen/space_xs"
                android:textColor="@color/mc_accent"
                android:textSize="@dimen/text_chip"
                tools:text="rinde 4" />

        </LinearLayout>
    </LinearLayout>

    <ImageView
        android:id="@+id/iv_chevron_comida"
        android:layout_width="@dimen/icon_size"
        android:layout_height="@dimen/icon_size"
        android:src="@drawable/ic_chevron"
        android:contentDescription="Ver detalle" />

</LinearLayout>