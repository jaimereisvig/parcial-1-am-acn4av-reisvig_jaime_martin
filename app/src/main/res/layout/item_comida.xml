<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_card"
    android:padding="16dp"
    android:layout_marginBottom="12dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_nombre_comida"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/mc_ink"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="Milanesas con puré" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <TextView
                android:id="@+id/tv_categoria_comida"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip_neutral"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:textColor="@color/mc_muted"
                android:textSize="12sp"
                tools:text="Carnes Rojas" />

            <TextView
                android:id="@+id/tv_rinde"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_chip_accent"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:textColor="@color/mc_accent"
                android:textSize="12sp"
                tools:text="rinde 4" />

        </LinearLayout>
    </LinearLayout>

    <ImageView
        android:id="@+id/iv_chevron_comida"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_chevron"
        android:contentDescription="Ver detalle" />

</LinearLayout>