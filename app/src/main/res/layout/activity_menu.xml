<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mc_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="@dimen/space_lg">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/screen_menu"
            android:textColor="@color/mc_ink"
            android:textSize="@dimen/text_title_screen"
            android:textStyle="bold"
            android:layout_marginBottom="@dimen/space_md" />

        <Spinner
            android:id="@+id/sp_dia"
            android:layout_width="match_parent"
            android:layout_height="@dimen/touch_height" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="@dimen/space_md">

            <LinearLayout
                android:id="@+id/ll_franjas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>

    </LinearLayout>

</FrameLayout>