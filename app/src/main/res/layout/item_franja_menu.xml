<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card"
    android:padding="@dimen/space_md"
    android:layout_marginBottom="@dimen/space_md">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tv_franja_titulo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/mc_ink"
            android:textSize="@dimen/text_title_item"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_agregar_franja"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/menu_agregar"
            android:textColor="@color/mc_accent"
            android:textSize="@dimen/text_action"
            android:textStyle="bold"
            android:padding="@dimen/space_xs" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ll_comidas_franja"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="@dimen/space_sm" />

    <TextView
        android:id="@+id/tv_franja_vacia"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/menu_franja_vacia"
        android:textColor="@color/mc_muted"
        android:textSize="@dimen/text_body"
        android:layout_marginTop="@dimen/space_sm" />

</LinearLayout>