<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mc_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="@dimen/space_lg">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ingredientes"
            android:textColor="@color/mc_ink"
            android:textSize="@dimen/text_title_screen"
            android:textStyle="bold"
            android:layout_marginBottom="@dimen/space_md" />

        <EditText
            android:id="@+id/et_buscar"
            style="@style/McInput"
            android:inputType="text"
            android:hint="Buscar ingrediente" />

        <Spinner
            android:id="@+id/sp_filtro_gondola"
            android:layout_width="match_parent"
            android:layout_height="@dimen/touch_height"
            android:layout_marginTop="@dimen/space_sm" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="@dimen/space_md">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_ingredientes"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false" />

            <TextView
                android:id="@+id/tv_vacio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="No hay ingredientes que coincidan"
                android:textColor="@color/mc_muted"
                android:textSize="@dimen/text_body"
                android:visibility="gone" />

        </FrameLayout>

    </LinearLayout>

    <ImageButton
        android:id="@+id/fab_nuevo"
        android:layout_width="@dimen/fab_size"
        android:layout_height="@dimen/fab_size"
        android:layout_gravity="bottom|end"
        android:layout_margin="@dimen/space_lg"
        android:background="@drawable/bg_fab"
        android:src="@drawable/ic_add"
        android:scaleType="center"
        android:contentDescription="Nuevo ingrediente" />

</FrameLayout>