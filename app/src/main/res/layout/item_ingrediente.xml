<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card"
    android:padding="16dp"
    android:layout_marginBottom="12dp">

    <TextView
        android:id="@+id/tv_nombre"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textColor="@color/mc_ink"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toStartOf="@id/iv_chevron"
        tools:text="Tomate perita" />

    <TextView
        android:id="@+id/tv_gondola"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_chip_neutral"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        android:textColor="@color/mc_muted"
        android:textSize="12sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_nombre"
        tools:text="Verdulería" />

    <TextView
        android:id="@+id/tv_en_uso"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_chip_accent"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        android:textColor="@color/mc_accent"
        android:textSize="12sp"
        app:layout_constraintStart_toEndOf="@id/tv_gondola"
        app:layout_constraintTop_toTopOf="@id/tv_gondola"
        app:layout_constraintBottom_toBottomOf="@id/tv_gondola"
        tools:text="en uso · 4" />

    <ImageView
        android:id="@+id/iv_chevron"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_chevron"
        android:contentDescription="Ver detalle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>