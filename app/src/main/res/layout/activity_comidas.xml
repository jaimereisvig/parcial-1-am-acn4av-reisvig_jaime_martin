<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mc_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="@dimen/space_lg">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="@dimen/space_md">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/screen_comidas"
                android:textColor="@color/mc_ink"
                android:textSize="@dimen/text_title_screen"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_ver_sugeridas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="@dimen/space_sm"
                android:text="@string/comidas_ver_sugeridas"
                android:textColor="@color/mc_accent"
                android:textSize="@dimen/text_action" />
        </LinearLayout>

        <EditText
            android:id="@+id/et_buscar_comida"
            style="@style/McInput"
            android:inputType="text"
            android:hint="@string/hint_buscar_comida" />

        <Spinner
            android:id="@+id/sp_filtro_categoria_comida"
            android:layout_width="match_parent"
            android:layout_height="@dimen/touch_height"
            android:layout_marginTop="@dimen/space_sm" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="@dimen/space_md">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_comidas"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingTop="@dimen/space_xs"
                android:clipToPadding="false" />

            <TextView
                android:id="@+id/tv_vacio_comida"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="@string/comidas_vacio"
                android:textColor="@color/mc_muted"
                android:textSize="@dimen/text_body"
                android:visibility="gone" />

        </FrameLayout>

    </LinearLayout>

    <ImageButton
        android:id="@+id/fab_nuevo_comida"
        android:layout_width="@dimen/fab_size"
        android:layout_height="@dimen/fab_size"
        android:layout_gravity="bottom|end"
        android:layout_margin="@dimen/space_lg"
        android:background="@drawable/bg_fab"
        android:src="@drawable/ic_add"
        android:scaleType="center"
        android:contentDescription="@string/comida_nueva" />

</FrameLayout>